# Copy to .env.local. Expo inlines EXPO_PUBLIC_* at bundle time; restart the bundler after edits.

# Widget hosted-page URL (origin + embed key), from the install snippet in Mentiora admin.
EXPO_PUBLIC_MENTIORA_WIDGET_URL=https://widget.acme.mentiora.ai/h/rn/pk_wgt_a1b2c3d4e5f6

# Optional; unset means anonymous chat only. Mentiora admin: Embed -> Identity keys.
# Belongs on your server in a real app; src/fake-backend.ts stands in for it. Never ship it.
# EXPO_PUBLIC_MENTIORA_IDENTITY_SECRET=pik_live_0123456789abcdef0123456789abcdef
