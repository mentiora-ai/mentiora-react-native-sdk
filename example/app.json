{
  "expo": {
    "name": "Mentiora Example",
    "slug": "mentiora-example",
    "scheme": "mentioraexample",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-notifications"],
    "ios": {
