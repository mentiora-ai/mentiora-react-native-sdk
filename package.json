{
  "name": "@mentiora/react-native-sdk",
  "version": "0.1.0",
  "description": "Mentiora chat for React Native and Expo. A thin wrapper around react-native-webview implementing the host side of mobile bridge protocol v1.",
  "license": "MIT",
  "author": "Mentiora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mentiora-ai/mentiora-react-native-sdk.git"
  },
  "homepage": "https://github.com/mentiora-ai/mentiora-react-native-sdk#readme",
  "bugs": "https://github.com/mentiora-ai/mentiora-react-native-sdk/issues",
  "keywords": [
    "react-native",
    "expo",
    "webview",
    "chat",
    "mentiora"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/commonjs/index.d.ts",
  "exports": {
    ".": {
      "mentiora-react-native-sdk-source": "./src/index.ts",
      "react-native": {
        "types": "./lib/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "import": {
        "types": "./lib/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "workspaces": [
    "example"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "clean": "rm -rf lib",
    "build": "bun run clean && bun run gen:version && bun run build:cjs && bun run build:esm && node scripts/finalize-build.mjs",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "bundle:example": "cd example && bun x expo export --platform ios && bun x expo export --platform android",
    "check:example-mint": "bun run scripts/check-example-mint.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:core": "rm -rf lib-test && tsc -p tsconfig.test.json && node scripts/run-core-tests.mjs",
    "test": "bun run test:core && jest",
    "assert:version": "node scripts/assert-version.mjs",
    "prepack": "bun run build",
    "hooks": "lefthook install"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.23.1 <4",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-safe-area-context": "*",
    "react-native-webview": ">=13.6.0 <17"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@biomejs/biome": "2.5.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14",
    "@types/jest": "30.0.0",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "babel-jest": "30.5.1",
    "jest": "30",
    "lefthook": "2.1.12",
    "publint": "0.3.24",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1",
    "test-renderer": "1",
    "typescript": "6.0.3"
  },
  "type": "commonjs"
}
