{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "lib/commonjs",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "verbatimModuleSyntax": false,
    "declarationMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "example", "**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
